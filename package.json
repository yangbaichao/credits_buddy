{
  "name": "workbuddy-credit-dashboard",
  "displayName": "WorkBuddy Credit Dashboard",
  "description": "不用离开编辑器，实时查看 WorkBuddy / CodeBuddy 积分余额、每日消耗明细与签到状态，支持多账号切换。",
  "version": "0.1.2",
  "icon": "media/marketplace-icon.png",
  "publisher": "yangbaichao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangbaichao/credits_buddy.git"
  },
  "homepage": "https://github.com/yangbaichao/credits_buddy#readme",
  "bugs": {
    "url": "https://github.com/yangbaichao/credits_buddy/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "workbuddy",
    "codebuddy",
    "credits",
    "dashboard",
    "积分",
    "额度",
    "签到",
    "用量"
  ],
  "activationEvents": [
    "onCommand:workbuddy-credit.openDashboard",
    "onCommand:workbuddy-credit.refresh",
    "onCommand:workbuddy-credit.logout",
    "onView:workbuddyCredit.dashboard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workbuddy-credit.openDashboard",
        "title": "WorkBuddy: 打开积分看板",
        "icon": "$(graph)"
      },
      {
        "command": "workbuddy-credit.refresh",
        "title": "WorkBuddy: 刷新积分数据"
      },
      {
        "command": "workbuddy-credit.logout",
        "title": "WorkBuddy: 退出登录"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workbuddyCredit",
          "title": "WorkBuddy 积分看板",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "workbuddyCredit": [
        {
          "type": "webview",
          "id": "workbuddyCredit.dashboard",
          "name": "积分看板"
        }
      ]
    },
    "configuration": {
      "title": "WorkBuddy Credit Dashboard",
      "properties": {
        "workbuddyCredit.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "自动刷新间隔（分钟），0 表示关闭自动刷新"
        },
        "workbuddyCredit.region": {
          "type": "string",
          "enum": [
            "cn",
            "global"
          ],
          "default": "cn",
          "description": "新增账号使用的服务地址：cn = www.workbuddy.cn，global = www.codebuddy.cn；已保存账号不受影响"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "flatpickr": "^4.6.13",
    "sortablejs": "^1.15.7"
  }
}
